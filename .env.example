# Konfigurasi Flask
FLASK_SECRET_KEY=absensi_ai_super_secret_key_2026_xyz
FLASK_ENV=development
DEBUG=True
PORT=5000
HOST=0.0.0.0

# Konfigurasi Firebase
# URL Realtime Database Firebase
FIREBASE_DATABASE_URL=https://absensi-ai-6cced-default-rtdb.firebaseio.com/
# Path ke serviceAccountKey.json (download dari Firebase Console -> Project Settings -> Service Accounts)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Konfigurasi Pengenalan Wajah (Threshold kemiripan 0.0 - 1.0, default 0.50)
# Nilai distance lebih kecil = semakin mirip
FACE_RECOGNITION_THRESHOLD=0.50

# Aturan Jam Absensi (Format HH:MM)
ATTENDANCE_START_TIME=07:00
ATTENDANCE_LATE_TIME=07:15
